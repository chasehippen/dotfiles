[user]
    email = chase.d.hippen@gmail.com
    name = chasehippen
[init]
    defaultBranch = main
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
[merge]
    conflictstyle = zdiff3
[rerere]
    enabled = true
[pull]
    rebase = true
[fetch]
    prune = true
[diff]
    algorithm = histogram
    colorMoved = default
[rebase]
    autoStash = true
